<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Presentation embed</title>
  <style>
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background: transparent;
      overflow: hidden;
    }
    .slides-crop {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: transparent;
    }
    .slides-crop iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: calc(100% + 3px);
      height: calc(100% + 3px);
      margin: 0;
      padding: 0;
      border: 0;
      display: block;
    }
  </style>
</head>
<body>
  <div class="slides-crop">
    <iframe
      src="https://docs.google.com/presentation/d/e/2PACX-1vRaANtxrILjckrpBaLztysxwiXBl0NbHz4vC1_aXTagvB6cw64T6LDlIU_nItprCO_EfwjfWUt4m0S8/pubembed?start=true&amp;loop=true&amp;delayms=2000&amp;rm=minimal"
      title="Presentation"
      allowfullscreen
      loading="eager">
    </iframe>
  </div>
</body>
</html>
